# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=ganti-dengan-secret-acak-anda

# NVIDIA AI (Opsional)
NVIDIA_API_KEY=

# ==========================================
# META WHATSAPP CLOUD API (Official Meta)
# Dapatkan kredensial di https://developers.facebook.com
# ==========================================
# 1. Token Akses Meta (System User Token permanen atau Temporary Token dari panel App)
WHATSAPP_ACCESS_TOKEN=

# 2. Phone Number ID dari Meta App Dashboard (WhatsApp -> API Setup -> Phone number ID)
WHATSAPP_PHONE_NUMBER_ID=

# 3. Nomor WhatsApp Admin penerima rincian pesanan saat checkout (Format: 628xxx)
WHATSAPP_ADMIN_PHONE=6281316520717

# 4. Versi Meta Graph API (Opsional, default: v21.0)
WHATSAPP_API_VERSION=v21.0

# ==========================================
# GMAIL SMTP (NODEMAILER) EMAIL NOTIFICATIONS
# Kirim email ke semua pelanggan tanpa batasan domain
# Panduan App Password: https://myaccount.google.com/apppasswords
# ==========================================
# 1. Alamat Gmail Pengirim (Contoh: toko.ojolali@gmail.com)
GMAIL_USER=

# 2. Google App Password (16 karakter unik, contoh: abcd efgh ijkl mnop)
# Catatan: Buat di Akun Google -> Keamanan -> Verifikasi 2 Langkah -> Sandi Aplikasi (App Passwords)
GMAIL_APP_PASS=

# 3. Nama Tampilan Pengirim (Opsional, default: Baso & Mie Ayam Ojolali)
GMAIL_FROM_NAME="Baso & Mie Ayam Ojolali"

